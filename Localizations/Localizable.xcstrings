  "strings": {
    "OAuth authorization was declined.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth authorization was declined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth授权被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth授權遭拒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth認可が拒否されました。"
          }
        }
      }
    },
    "OAuth requires secure HTTPS endpoints.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth requires secure HTTPS endpoints."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth要求安全的HTTPS端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth要求安全的HTTPS端點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuthには安全なHTTPSエンドポイントが必要です。"
          }
        }
      }
    },
    "Sign in to this MCP server to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
