    "Line %lld exceeds the %lld-byte page limit. Use a targeted byte slice or search.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第%1$lld行超出每页%2$lld字节的限制。请按字节截取所需片段或搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第%1$lld行超出每頁%2$lld位元組的限制。請按位元組擷取所需片段或搜尋。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld行目が1ページあたり%2$lldバイトの上限を超えています。必要なバイト範囲を指定して読み取るか、検索してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeile %1$lld überschreitet die Seitengrenze von %2$lld Bytes. Lesen Sie einen gezielten Bytebereich oder verwenden Sie die Suche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ligne %1$lld dépasse la limite de %2$lld octets par page. Lisez une plage d’octets ciblée ou effectuez une recherche."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld번째 줄이 페이지당 %2$lld바이트 한도를 초과합니다. 필요한 바이트 범위를 지정하여 읽거나 검색하세요."
          }
        }
      }
    },
