  "strings": {
    "OAuth authorization was declined.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth authorization was declined."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth授权被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth授權遭拒。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth認可が拒否されました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die OAuth-Autorisierung wurde abgelehnt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation OAuth a été refusée."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth 인가가 거부되었습니다."
          }
        }
      }
    },
    "OAuth requires secure HTTPS endpoints.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth requires secure HTTPS endpoints."
          }
