          }
        }
      }
    },
    "The current transport, using one endpoint for POST and GET.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前传输方式，使用同一端点处理POST和GET。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前傳輸方式，使用同一端點處理POST和GET。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "POSTとGETに同じエンドポイントを使用する現行の方式です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Transportverfahren verwendet einen Endpunkt für POST und GET."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transport actuel utilise un seul point de terminaison pour POST et GET."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "POST와 GET에 하나의 엔드포인트를 사용하는 현재 전송 방식입니다."
          }
        }
      }
    },
    "The description is longer than %lld characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述超过%lld个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "描述超過%lld個字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明が%lld文字を超えています。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Beschreibung überschreitet die Grenze von %lld Zeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La description dépasse la limite de %lld caractères."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설명이 %lld자를 초과합니다."
          }
        }
      }
    },
    "The differing region spans %lld lines, past the %lld-line diff limit. Narrow it with a bounded read of each side instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差异区域跨越%1$lld行，超过%2$lld行的差异限制。请分别读取两侧的有限范围以缩小差异。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "差異區域跨越%1$lld行，超過%2$lld行的差異限制。請分別讀取兩側的有限範圍以縮小差異。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分の範囲が%1$lld行あり、差分の上限の%2$lld行を超えています。それぞれのファイルを範囲を限定して読み取り、差分を絞り込んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der abweichende Bereich umfasst %1$lld Zeilen und überschreitet die Diff-Grenze von %2$lld Zeilen. Lesen Sie stattdessen einen begrenzten Bereich jeder Datei, um den Unterschied einzugrenzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La zone différente s’étend sur %1$lld lignes, au-delà de la limite de %2$lld lignes du diff. Réduisez la portée en lisant une plage limitée de chaque fichier."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차이가 있는 영역이 %1$lld줄에 걸쳐 있어 비교 한도인 %2$lld줄을 초과합니다. 대신 각 파일에서 범위를 제한하여 읽고 비교 범위를 좁히세요."
          }
        }
      }
    },
    "The endpoint answered %lld.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点返回了%lld。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端點傳回了%lld。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントが%lldを返しました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Endpunkt hat mit %lld geantwortet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de terminaison a répondu avec le code %lld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트가 %lld 코드를 반환했습니다."
          }
        }
      }
    },
    "The endpoint answered, but not with a model list.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点已响应，但未返回模型列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端點已回應，但未傳回模型清單。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドポイントは応答しましたが、モデル一覧を返しませんでした。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Endpunkt hat geantwortet, aber keine Modellliste zurückgegeben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de terminaison a répondu, mais sans liste de modèles."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "엔드포인트가 응답했지만 모델 목록을 반환하지 않았습니다."
          }
        }
      }
    },
    "The endpoint did not answer with HTTP.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点没有用HTTP回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端點未以HTTP回應。"
          }
        },
        "ja": {
