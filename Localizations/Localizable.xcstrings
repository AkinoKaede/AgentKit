    "A skill may be at most %lld KB.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能最大为%lld KB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能最大為%lld KB。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキルのサイズは%lld KB以下にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skill darf höchstens %lld KB groß sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille d’une compétence ne doit pas dépasser %lld Ko."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킬 크기는 최대 %lld KB여야 합니다."
          }
        }
      }
    },
    "A skill name may be at most %lld characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称最多%lld个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱最多%lld個字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキル名は%lld文字以内にしてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skill-Name darf höchstens %lld Zeichen lang sein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’une compétence ne doit pas dépasser %lld caractères."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킬 이름은 최대 %lld자여야 합니다."
          }
        }
      }
    },
    "A skill name may not begin or end with a hyphen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称不能以连字符开头或结尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱不能以連字元開頭或結尾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキル名の先頭または末尾にハイフンは使用できません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skill-Name darf nicht mit einem Bindestrich beginnen oder enden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’une compétence ne doit ni commencer ni se terminer par un trait d’union."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킬 이름은 하이픈으로 시작하거나 끝날 수 없습니다."
          }
        }
      }
    },
    "A skill name may not contain two hyphens in a row.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称不能包含连续两个连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱不能包含連續兩個連字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキル名にハイフンを2つ続けて使用することはできません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skill-Name darf keine zwei aufeinanderfolgenden Bindestriche enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’une compétence ne doit pas contenir deux traits d’union consécutifs."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스킬 이름에는 하이픈 두 개를 연속으로 사용할 수 없습니다."
          }
        }
      }
    },
    "A skill name may use only lowercase letters, digits, and hyphens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称只能使用小写字母、数字和连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱只能使用小寫字母、數字和連字元。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキル名には小文字の英字、数字、ハイフンのみ使用できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Skill-Name darf nur Kleinbuchstaben, Ziffern und Bindestriche enthalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom d’une compétence ne peut contenir que des lettres minuscules, des chiffres et des traits d’union."
          }
        },
        "ko": {
