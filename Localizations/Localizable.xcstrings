        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth要求安全的HTTPS端点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth要求安全的HTTPS端點。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuthには安全なHTTPSエンドポイントが必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth erfordert sichere HTTPS-Endpunkte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OAuth nécessite des points de terminaison HTTPS sécurisés."
