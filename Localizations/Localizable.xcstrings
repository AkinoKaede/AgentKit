        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキル名にハイフンを2つ続けて使用することはできません。"
          }
        }
      }
    },
    "A skill name may use only lowercase letters, digits, and hyphens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称只能使用小写字母、数字和连字符。"
