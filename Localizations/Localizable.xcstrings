    "%@ is unavailable while planning: nothing has been agreed to yet, so there is no work to track. Finish the plan and call present_plan.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在规划时不可用：尚未达成任何约定，因此没有需要跟踪的工作。请先完成计划并调用present_plan。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@在規劃時不可用：尚未達成任何約定，因此沒有需要追蹤的工作。請先完成計畫並呼叫present_plan。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画中は%@を利用できません。まだ合意された内容がないため、追跡する作業がありません。計画を完成させ、present_planを呼び出してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist während der Planung nicht verfügbar: Es wurde noch nichts vereinbart, daher gibt es keine Arbeit zu verfolgen. Schließen Sie den Plan ab und rufen Sie present_plan auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est indisponible pendant la planification : rien n’a encore été convenu, il n’y a donc aucun travail à suivre. Terminez le plan et appelez present_plan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획 중에는 %@ 도구를 사용할 수 없습니다. 아직 합의된 내용이 없어 추적할 작업이 없습니다. 계획을 완성한 다음 present_plan을 호출하세요."
          }
        }
      }
    },
