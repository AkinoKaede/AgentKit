          "stringUnit": {
            "state": "translated",
            "value": "技能最大為%lld KB。"
          }
        }
      }
    },
    "A skill name may be at most %lld characters.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称最多%lld个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱最多%lld個字元。"
          }
        }
      }
    },
    "A skill name may not begin or end with a hyphen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称不能以连字符开头或结尾。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱不能以連字元開頭或結尾。"
          }
        }
      }
    },
    "A skill name may not contain two hyphens in a row.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称不能包含连续两个连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱不能包含連續兩個連字元。"
          }
        }
      }
    },
    "A skill name may use only lowercase letters, digits, and hyphens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名称只能使用小写字母、数字和连字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能名稱只能使用小寫字母、數字和連字元。"
          }
        }
      }
    },
    "A skill needs a description saying what it does and when to use it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "技能需要一段描述，说明它做什么以及何时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "技能需要一段描述，說明它做什麼以及何時使用。"
          }
        }
      }
    },
    "A skill needs a name.": {
